//@version=5
indicator("Time Dilation Trend Visualizer [EZPZ]", overlay=true, max_labels_count=500, max_lines_count=500, max_bars_back=5000)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░ INPUT PARAMETERS ░░░
// ══════════════════════════════════════════════════════════════════════════════

// --- MA Ribbon Settings ---
grp_ribbon = "══════ MA Ribbon Settings ══════"
ema_len1  = input.int(5,   "EMA 1 Length", group=grp_ribbon)
ema_len2  = input.int(8,   "EMA 2 Length", group=grp_ribbon)
ema_len3  = input.int(13,  "EMA 3 Length", group=grp_ribbon)
ema_len4  = input.int(21,  "EMA 4 Length", group=grp_ribbon)
ema_len5  = input.int(34,  "EMA 5 Length", group=grp_ribbon)
ema_len6  = input.int(55,  "EMA 6 Length", group=grp_ribbon)
ema_len7  = input.int(89,  "EMA 7 Length", group=grp_ribbon)
ema_len8  = input.int(144, "EMA 8 Length", group=grp_ribbon)
ribbon_src = input.source(close, "Source", group=grp_ribbon)

// --- Structure Detection Settings ---
grp_struct = "══════ Structure Detection ══════"
swing_lookback = input.int(10, "Swing Lookback", minval=2, maxval=50, group=grp_struct)
show_5min  = input.bool(true, "Show 5 Min Structure", group=grp_struct)
show_15min = input.bool(true, "Show 15 Min Structure", group=grp_struct)
show_1h    = input.bool(true, "Show 1H Structure", group=grp_struct)

// --- Signal Settings ---
grp_signal = "══════ BULL/BEAR Signal Settings ══════"
trend_confirm = input.int(2, "Min TF Alignment for Signal", minval=1, maxval=3, group=grp_signal)

// --- Key Level Settings ---
grp_levels = "══════ Key Level Settings ══════"
show_levels   = input.bool(true, "Show Key Levels", group=grp_levels)
max_levels    = input.int(3, "Max Levels Per Side", minval=1, maxval=10, group=grp_levels)
level_extend  = input.int(50, "Level Extend (bars)", minval=10, maxval=500, group=grp_levels)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░ COMPONENT A: EMA RIBBON ░░░
// ══════════════════════════════════════════════════════════════════════════════

ema1 = ta.ema(ribbon_src, ema_len1)
ema2 = ta.ema(ribbon_src, ema_len2)
ema3 = ta.ema(ribbon_src, ema_len3)
ema4 = ta.ema(ribbon_src, ema_len4)
ema5 = ta.ema(ribbon_src, ema_len5)
ema6 = ta.ema(ribbon_src, ema_len6)
ema7 = ta.ema(ribbon_src, ema_len7)
ema8 = ta.ema(ribbon_src, ema_len8)

// Trend state: fast EMA above slow EMA = bullish
is_bull = ema1 > ema8

// Plot EMAs (invisible lines for fill anchors)
p1 = plot(ema1, color=color.new(color.gray, 100), display=display.none)
p2 = plot(ema2, color=color.new(color.gray, 100), display=display.none)
p3 = plot(ema3, color=color.new(color.gray, 100), display=display.none)
p4 = plot(ema4, color=color.new(color.gray, 100), display=display.none)
p5 = plot(ema5, color=color.new(color.gray, 100), display=display.none)
p6 = plot(ema6, color=color.new(color.gray, 100), display=display.none)
p7 = plot(ema7, color=color.new(color.gray, 100), display=display.none)
p8 = plot(ema8, color=color.new(color.gray, 100), display=display.none)

// Gradient fills between adjacent EMAs
// Bullish: bright green → dark green (inner → outer)
// Bearish: bright red → dark red (inner → outer)
fill(p1, p2, color=is_bull ? color.new(#00FF41, 30) : color.new(#FF1744, 30))
fill(p2, p3, color=is_bull ? color.new(#00E53A, 40) : color.new(#FF2D55, 40))
fill(p3, p4, color=is_bull ? color.new(#00CC33, 50) : color.new(#E53935, 50))
fill(p4, p5, color=is_bull ? color.new(#00B32D, 58) : color.new(#D32F2F, 58))
fill(p5, p6, color=is_bull ? color.new(#009926, 65) : color.new(#C62828, 65))
fill(p6, p7, color=is_bull ? color.new(#008020, 72) : color.new(#B71C1C, 72))
fill(p7, p8, color=is_bull ? color.new(#00661A, 80) : color.new(#9B1B1B, 80))

// ══════════════════════════════════════════════════════════════════════════════
// ░░░ COMPONENT B: MULTI-TIMEFRAME STRUCTURE DETECTION (BOS / MSS) ░░░
// ══════════════════════════════════════════════════════════════════════════════

// --- Helper function: detect structure breaks ---
// Returns: [bos_bull, bos_bear, mss_bull, mss_bear, current_trend, swing_h, swing_l]
f_structure_logic(float htf_ph, float htf_pl, float htf_close) =>
    // Track swing levels
    var float prev_sh = na
    var float prev_sl = na
    var float last_sh = na
    var float last_sl = na
    var int trend = 0

    // Update swing highs
    if not na(htf_ph)
        prev_sh := last_sh
        last_sh := htf_ph

    // Update swing lows
    if not na(htf_pl)
        prev_sl := last_sl
        last_sl := htf_pl

    // Determine trend (higher highs + higher lows = up, lower lows + lower highs = down)
    if not na(last_sh) and not na(prev_sh) and not na(last_sl) and not na(prev_sl)
        if last_sh > prev_sh and last_sl > prev_sl
            trend := 1
        else if last_sh < prev_sh and last_sl < prev_sl
            trend := -1

    // Detect breaks
    bos_bull  = trend == 1  and not na(last_sh) and ta.crossover(htf_close, last_sh)
    bos_bear  = trend == -1 and not na(last_sl) and ta.crossunder(htf_close, last_sl)
    mss_bull  = trend == -1 and not na(last_sh) and ta.crossover(htf_close, last_sh)
    mss_bear  = trend == 1  and not na(last_sl) and ta.crossunder(htf_close, last_sl)

    // Update trend on MSS
    if mss_bull
        trend := 1
    if mss_bear
        trend := -1

    [bos_bull, bos_bear, mss_bull, mss_bear, trend, last_sh, last_sl]

// --- 5 Min Data ---
[ph_5, pl_5, close_5] = request.security(syminfo.tickerid, "5", [ta.pivothigh(high, swing_lookback, swing_lookback), ta.pivotlow(low, swing_lookback, swing_lookback), close], lookahead=barmerge.lookahead_off)
[bos_bull_5, bos_bear_5, mss_bull_5, mss_bear_5, trend_5, sh_5, sl_5] = f_structure_logic(ph_5, pl_5, close_5)

// --- 15 Min Data ---
[ph_15, pl_15, close_15] = request.security(syminfo.tickerid, "15", [ta.pivothigh(high, swing_lookback, swing_lookback), ta.pivotlow(low, swing_lookback, swing_lookback), close], lookahead=barmerge.lookahead_off)
[bos_bull_15, bos_bear_15, mss_bull_15, mss_bear_15, trend_15, sh_15, sl_15] = f_structure_logic(ph_15, pl_15, close_15)

// --- 1H Data ---
[ph_60, pl_60, close_60] = request.security(syminfo.tickerid, "60", [ta.pivothigh(high, swing_lookback, swing_lookback), ta.pivotlow(low, swing_lookback, swing_lookback), close], lookahead=barmerge.lookahead_off)
[bos_bull_60, bos_bear_60, mss_bull_60, mss_bear_60, trend_60, sh_60, sl_60] = f_structure_logic(ph_60, pl_60, close_60)

// --- Render BOS / MSS Labels ---
// 5 Min Labels
if show_5min
    if bos_bull_5
        label.new(bar_index, low, "BOS\n5Min", style=label.style_label_up, color=color.new(#00E676, 20), textcolor=color.white, size=size.small)
    if bos_bear_5
        label.new(bar_index, high, "BOS\n5Min", style=label.style_label_down, color=color.new(#FF5252, 20), textcolor=color.white, size=size.small)
    if mss_bull_5
        label.new(bar_index, low, "MSS\n5Min", style=label.style_label_up, color=color.new(#00BFA5, 20), textcolor=color.white, size=size.small)
    if mss_bear_5
        label.new(bar_index, high, "MSS\n5Min", style=label.style_label_down, color=color.new(#FF4081, 20), textcolor=color.white, size=size.small)

// 15 Min Labels
if show_15min
    if bos_bull_15
        label.new(bar_index, low, "BOS\n15Min", style=label.style_label_up, color=color.new(#00E676, 20), textcolor=color.white, size=size.small)
    if bos_bear_15
        label.new(bar_index, high, "BOS\n15Min", style=label.style_label_down, color=color.new(#FF5252, 20), textcolor=color.white, size=size.small)
    if mss_bull_15
        label.new(bar_index, low, "MSS\n15Min", style=label.style_label_up, color=color.new(#00BFA5, 20), textcolor=color.white, size=size.small)
    if mss_bear_15
        label.new(bar_index, high, "MSS\n15Min", style=label.style_label_down, color=color.new(#FF4081, 20), textcolor=color.white, size=size.small)

// 1H Labels
if show_1h
    if bos_bull_60
        label.new(bar_index, low, "BOS\n1H", style=label.style_label_up, color=color.new(#00E676, 20), textcolor=color.white, size=size.normal)
    if bos_bear_60
        label.new(bar_index, high, "BOS\n1H", style=label.style_label_down, color=color.new(#FF5252, 20), textcolor=color.white, size=size.normal)
    if mss_bull_60
        label.new(bar_index, low, "MSS\n1H", style=label.style_label_up, color=color.new(#00BFA5, 20), textcolor=color.white, size=size.normal)
    if mss_bear_60
        label.new(bar_index, high, "MSS\n1H", style=label.style_label_down, color=color.new(#FF4081, 20), textcolor=color.white, size=size.normal)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░ COMPONENT C: BULL / BEAR TREND CHANGE SIGNALS ░░░
// ══════════════════════════════════════════════════════════════════════════════

// Count aligned timeframes
bull_count = (trend_5 == 1 ? 1 : 0) + (trend_15 == 1 ? 1 : 0) + (trend_60 == 1 ? 1 : 0)
bear_count = (trend_5 == -1 ? 1 : 0) + (trend_15 == -1 ? 1 : 0) + (trend_60 == -1 ? 1 : 0)

// Combine with ribbon state for confirmation
all_bull = bull_count >= trend_confirm and is_bull
all_bear = bear_count >= trend_confirm and not is_bull

// Track trend state transitions
var int master_trend = 0
new_trend = all_bull ? 1 : all_bear ? -1 : master_trend

bull_signal = new_trend == 1 and master_trend != 1
bear_signal = new_trend == -1 and master_trend != -1

master_trend := new_trend

// ATR for label offset
atr_val = ta.atr(14)

// Render BULL/BEAR signals with plotshape for large circle effect
plotshape(bull_signal, title="BULL Signal", style=shape.circle, location=location.belowbar, color=color.new(#00E676, 0), size=size.large, text="BULL", textcolor=color.white)
plotshape(bear_signal, title="BEAR Signal", style=shape.circle, location=location.abovebar, color=color.new(#FF1744, 0), size=size.large, text="BEAR", textcolor=color.white)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░ COMPONENT D: HORIZONTAL KEY LEVELS ░░░
// ══════════════════════════════════════════════════════════════════════════════

if show_levels
    // Current timeframe pivot detection
    cur_ph = ta.pivothigh(high, swing_lookback, swing_lookback)
    cur_pl = ta.pivotlow(low, swing_lookback, swing_lookback)

    var line[] high_lines = array.new_line()
    var line[] low_lines  = array.new_line()

    // New swing high level (cyan)
    if not na(cur_ph)
        ln = line.new(bar_index - swing_lookback, cur_ph, bar_index + level_extend, cur_ph, color=color.new(#00E5FF, 20), style=line.style_solid, width=1, extend=extend.none)
        array.push(high_lines, ln)
        // Cleanup old levels
        if array.size(high_lines) > max_levels
            old_line = array.shift(high_lines)
            line.delete(old_line)

    // New swing low level (magenta/pink)
    if not na(cur_pl)
        ln = line.new(bar_index - swing_lookback, cur_pl, bar_index + level_extend, cur_pl, color=color.new(#FF4081, 20), style=line.style_solid, width=1, extend=extend.none)
        array.push(low_lines, ln)
        // Cleanup old levels
        if array.size(low_lines) > max_levels
            old_line = array.shift(low_lines)
            line.delete(old_line)

// ══════════════════════════════════════════════════════════════════════════════
// ░░░ CANDLE COLORING (optional visual enhancement) ░░░
// ══════════════════════════════════════════════════════════════════════════════

barcolor(is_bull ? color.new(#00E676, 60) : color.new(#FF5252, 60))
